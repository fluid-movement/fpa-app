# Production image for Coolify (build pack: Dockerfile, location: /Dockerfile.prod)
#
# PHP_VERSION defaults to the first release fixing CVE-2026-109618/109619.
# The build fails until that tag is published, so a vulnerable image can't ship by accident.
# For local testing before then: --build-arg PHP_VERSION=8.4
ARG PHP_VERSION=8.4.27

# --- PHP dependencies -------------------------------------------------------
FROM composer:2 AS vendor

# Coolify passes build-time env vars as build args; they only exist in this stage
ARG FLUX_AUTH_USER
ARG FLUX_AUTH_TOKEN

WORKDIR /app
COPY composer.json composer.lock ./
# Locally, mount auth.json instead: docker build --secret id=composer_auth,src=auth.json ...
RUN --mount=type=secret,id=composer_auth,target=/tmp/auth.json,required=false \
    if [ -f /tmp/auth.json ]; then cp /tmp/auth.json auth.json; \
    else composer config http-basic.composer.fluxui.dev "${FLUX_AUTH_USER}" "${FLUX_AUTH_TOKEN}"; fi \
    && composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction --ignore-platform-reqs \
    && rm -f auth.json

COPY . .
RUN composer dump-autoload --no-dev --optimize --no-scripts

# --- Frontend assets (needs vendor/ for the Flux CSS) -----------------------
FROM node:22-bookworm-slim AS assets

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY --from=vendor /app /app
RUN npm run build

# --- Runtime ----------------------------------------------------------------
FROM php:${PHP_VERSION}-fpm

RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx supervisor curl \
        libpq-dev libpng-dev libjpeg62-turbo-dev libwebp-dev libfreetype6-dev libicu-dev libzip-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j"$(nproc)" pdo_pgsql gd intl bcmath pcntl zip opcache exif \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default /usr/local/etc/php-fpm.d/www.conf* /usr/local/etc/php-fpm.d/zz-docker.conf

COPY docker/prod/php.ini /usr/local/etc/php/conf.d/zz-app.ini
COPY docker/prod/php-fpm.conf /usr/local/etc/php-fpm.d/www.conf
COPY docker/prod/nginx.conf /etc/nginx/nginx.conf
COPY docker/prod/supervisord.conf /etc/supervisor/supervisord.conf
COPY --chmod=755 docker/prod/start.sh /usr/local/bin/start

WORKDIR /var/www/html
COPY --chown=www-data:www-data . .
COPY --chown=www-data:www-data --from=vendor /app/vendor ./vendor
COPY --chown=www-data:www-data --from=assets /app/public/build ./public/build

RUN php artisan package:discover --ansi \
    && php artisan storage:link \
    && chown -R www-data:www-data storage bootstrap/cache

EXPOSE 80
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=5 CMD curl -fsS http://localhost/up || exit 1

CMD ["start"]
